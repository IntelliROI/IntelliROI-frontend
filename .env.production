# Used by `next build` (Netlify). Browser stays on same-origin /api-proxy/*.
# Do not put NEXT_PUBLIC_*_BASE=http://… here — that reintroduces Mixed Content.

NEXT_PUBLIC_USE_API_PROXY=true
NEXT_PUBLIC_APP_URL=https://intelliroi-web.netlify.app

