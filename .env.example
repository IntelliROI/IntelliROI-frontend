# ── Local LAN (browser → HTTP backends directly; use http://localhost:3000) ──
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# NEXT_PUBLIC_AUTH_BASE=http://127.0.0.1:8081
# NEXT_PUBLIC_ORG_BASE=http://127.0.0.1:8082
# NEXT_PUBLIC_BC_BASE=http://127.0.0.1:8083
# NEXT_PUBLIC_AI_BASE=http://127.0.0.1:8084
# NEXT_PUBLIC_COST_BASE=http://127.0.0.1:8085
# NEXT_PUBLIC_ROI_BASE=http://127.0.0.1:8086
# NEXT_PUBLIC_ANALYTICS_BASE=http://127.0.0.1:8087
# NEXT_PUBLIC_NOTIFY_BASE=http://127.0.0.1:8088
# NEXT_PUBLIC_BILLING_BASE=http://127.0.0.1:8089
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_USE_API_PROXY=false

# ── ngrok HTTPS (recommended for shared demos) ──
# Tunnel api-gateway :8080 (one URL for all routes) OR ai-gateway :8084 for chat.
# Explicit https:// bases are called DIRECTLY — /api-proxy is skipped (no Mixed Content).
#
# NEXT_PUBLIC_USE_API_PROXY=false
# NEXT_PUBLIC_API_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_AUTH_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_ORG_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_BC_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_AI_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_COST_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_ROI_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_ANALYTICS_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_NOTIFY_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_BILLING_BASE=https://YOUR-GATEWAY.ngrok-free.app
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# On the backend set CORS_ALLOWED_ORIGINS if the UI is not localhost / ngrok
# (ngrok UI origins are allowed automatically). Chat uses SSE keepalives so
# free ngrok does not idle-timeout during long completions.

# ── Netlify / HTTPS UI + HTTP backends (same-origin proxy) ──
# Production values live in netlify.toml + .env.production.
# In Netlify UI, DELETE any NEXT_PUBLIC_*_BASE=http://… vars, then redeploy.
# To use ngrok FROM Netlify instead of a static IP, set NEXT_PUBLIC_*_BASE to
# your https://….ngrok-free.app URLs (proxy is skipped for https bases).
#
# NEXT_PUBLIC_USE_API_PROXY=true
# NEXT_PUBLIC_APP_URL=https://intelliroi-web.netlify.app
#
# Server-only upstreams (Next rewrites) when you still need /api-proxy for http:// APIs:
# AUTH_UPSTREAM=http://103.46.235.22:8081
# ORG_UPSTREAM=http://103.46.235.22:8082
# BC_UPSTREAM=http://103.46.235.22:8083
# AI_UPSTREAM=http://103.46.235.22:8084
# COST_UPSTREAM=http://103.46.235.22:8085
# ROI_UPSTREAM=http://103.46.235.22:8086
# ANALYTICS_UPSTREAM=http://103.46.235.22:8087
# NOTIFY_UPSTREAM=http://103.46.235.22:8088
# BILLING_UPSTREAM=http://103.46.235.22:8089
# GATEWAY_UPSTREAM=http://103.46.235.22:8080
