# ── Local LAN (browser → HTTP backends directly; use http://localhost:3000) ──
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
# NEXT_PUBLIC_AUTH_BASE=http://127.0.0.1:8081
# NEXT_PUBLIC_ORG_BASE=http://127.0.0.1:8082
# NEXT_PUBLIC_BC_BASE=http://127.0.0.1:8083
# NEXT_PUBLIC_AI_BASE=http://127.0.0.1:8084
# NEXT_PUBLIC_COST_BASE=http://127.0.0.1:8085
# NEXT_PUBLIC_ROI_BASE=http://127.0.0.1:8086
# NEXT_PUBLIC_ANALYTICS_BASE=http://127.0.0.1:8087
# NEXT_PUBLIC_NOTIFY_BASE=http://127.0.0.1:8088
# NEXT_PUBLIC_BILLING_BASE=http://127.0.0.1:8089
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Netlify / HTTPS (same-origin proxy — required to avoid Mixed Content) ──
# Set these in Netlify UI and redeploy. Do NOT bake private LAN URLs into
# NEXT_PUBLIC_* for production unless you also enable the proxy below.
#
# NEXT_PUBLIC_USE_API_PROXY=true
# NEXT_PUBLIC_APP_URL=https://intelliroi-web.netlify.app
#
# Server-only upstreams (Next rewrites). Must be reachable FROM NETLIFY
# (public IP or tunnel — not a private 192.168.x.x from Netlify's cloud).
# AUTH_UPSTREAM=http://192.168.10.37:8081
# ORG_UPSTREAM=http://192.168.10.37:8082
# BC_UPSTREAM=http://192.168.10.37:8083
# AI_UPSTREAM=http://192.168.10.37:8084
# COST_UPSTREAM=http://192.168.10.37:8085
# ROI_UPSTREAM=http://192.168.10.37:8086
# ANALYTICS_UPSTREAM=http://192.168.10.37:8087
# NOTIFY_UPSTREAM=http://192.168.10.37:8088
# BILLING_UPSTREAM=http://192.168.10.37:8089
# GATEWAY_UPSTREAM=http://192.168.10.37:8080
